# STAGE 1: Build
FROM maven:3.9.3-eclipse-temurin-17 AS builder

WORKDIR /app

COPY pom.xml .
COPY src ./src

# Compila e empacota executando os testes
RUN mvn clean package

# STAGE 2: Runtime
FROM eclipse-temurin:17-jdk

WORKDIR /app

COPY --from=builder /app/target/At_CICD-1.0-SNAPSHOT.jar app.jar

CMD ["java", "-jar", "app.jar"]
